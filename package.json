{
  "name": "craft-coffee",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "db": "node scripts/dev-db.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "dev": "concurrently -n db,api,web -c yellow,magenta,cyan \"npm run db\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:db": "npm run db",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
