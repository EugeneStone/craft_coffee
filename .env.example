# ---- backend (backend/.env) ----
# Строка подключения. Локально её поднимает `npm run db`,
# в проде — например, бесплатная база Neon (https://neon.tech).
DATABASE_URL=postgres://kvarta:kvarta@localhost:5433/kvarta
PORT=4001

# Опционально: дублирование заявок в Telegram-бот.
# Токен от @BotFather и id чата (узнать: написать боту, затем открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- frontend (frontend/.env) ----
# Адрес API для прокси /api/* в next.config.ts.
# Локально не нужен (по умолчанию http://localhost:4001),
# в проде — публичный адрес бэкенда, например https://kvarta-api.onrender.com
# API_ORIGIN=https://your-api.example.com
